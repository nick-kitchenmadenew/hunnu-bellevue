# Dependencies. One tree at the repo root — this is an npm workspace over
# engine/ and site/, so both halves resolve to the same astro and js-yaml.
node_modules/

# Build output — regenerated by `npm run check`
site/dist/
site/.astro/
site/node_modules/

# Favicon family derived from site/public/icon-512.png and icon-180.png by
# derive-icons.mjs on every prebuild — only the two sources are committed.
site/public/favicon.ico
site/public/apple-touch-icon.png
site/public/apple-touch-icon-precomposed.png

# Vercel: the CLI's project link, and the staged output.
.vercel/
.vercel-out/

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Scratch
*.log
.env*

# Astro's content-collection cache. Normally under site/, but running a build
# from the repo root (rather than site/) generates it here instead — same
# artifact, different cwd, and it must not be committed either way.
.astro/
