---
import Rich from './Rich.astro';
/**
 * What backs the work: the facts a reader can check before hiring anybody.
 *
 * Deliberately a different shape from WhyUs, which runs one argument in four
 * long parts down a single column. This is the opposite kind of content — a
 * handful of short facts a wary reader scans rather than reads, in the order
 * they think of them. A two-column grid of terse rows says "check these" where
 * a stack of paragraphs says "read this", and each row finishes in a line or two.
 *
 * No badges, seals or logos. The operations document is explicit that this
 * business holds no industry certifications and competes on thirteen years of
 * results instead, so a wall of trust marks would be inventing credentials
 * inside a block whose entire premise is that everything in it is checkable.
 */
const { items } = Astro.props;
---
<dl class="creds">
  {items.map((c) => (
    <div class="creds__item">
      <dt class="creds__term"><Rich text={c.title} /></dt>
      <dd class="creds__body"><Rich text={c.body} /></dd>
    </div>
  ))}
</dl>
