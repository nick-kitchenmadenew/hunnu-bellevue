---
import Rich from './Rich.astro';
import { injectAnchor } from '../lib/prose.js';
/** Renders the FAQ. Base.astro generates FAQPage schema from the SAME array,
    so the markup cannot drift from what a visitor sees.

    An entry may carry `to` and `anchor`, which turns the marked words in the
    answer into a link down to the supporting article that answers the question
    properly. The schema keeps the plain text — stripInline runs upstream — so a
    link in the answer never leaks markup into FAQPage. */
const { items = [], heading, base = '' } = Astro.props;
---
<dl class="faq">
  {items.map((f) => (
    <div class="faq__row">
      <dt>{f.q}</dt>
      <dd>{f.to
        ? <p set:html={injectAnchor(f.a, { href: `${base}${f.to}/`.replace(/\/+/g, '/'), anchor: f.anchor })} />
        : <Rich text={f.a} />}</dd>
    </div>
  ))}
</dl>
<style>
  .faq { margin: 0; }
  /* The answer column is sized TO the measure rather than given a share of the
     remainder. Now that this spans the full 1180px, a 1.35fr answer column would
     be ~678px while the dd inside caps at --measure (611px) — so every answer
     would stop 67px short of the right margin and the FAQ would be the one band
     on the page with a ragged right edge. Sizing the column to the measure lands
     it exactly on the grid; the question column takes what is left. */
  .faq__row { display: grid; grid-template-columns: minmax(230px, 1fr) minmax(0, var(--measure));
    gap: var(--gap-m); padding-block: var(--gap-m); border-top: 1px solid var(--border); }
  .faq__row:last-child { border-bottom: 1px solid var(--border); }
  .faq dt { font-family: var(--font-display); font-weight: 600; font-size: var(--step-1);
    line-height: 1.25; text-wrap: balance; }
  .faq dd { margin: 0; color: var(--muted); }
  @media (max-width: 780px) {
    .faq__row { grid-template-columns: 1fr; gap: 0.5rem; padding-block: var(--gap-s); }
  }
</style>
