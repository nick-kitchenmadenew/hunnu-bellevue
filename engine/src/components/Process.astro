---
import Rich from './Rich.astro';
/** Numbering is used here because the order carries real information — this is a
    literal Monday-to-Friday sequence, and it is the most reassuring content on the
    page for someone dreading a wrecked kitchen. */
const { steps = [] } = Astro.props;
---
<ol class="proc">
  {steps.map((s) => (
    <li class="proc__step">
      <p class="proc__day">{s.day}</p>
      <h3 class="proc__title">{s.title}</h3>
      <p class="proc__body"><Rich text={s.body} /></p>
    </li>
  ))}
</ol>
<style>
  /* Was repeat(5, 1fr), written when every process had five steps. The homepage
     has four — refacing is day one, days two and three, days four and five, final
     day — so the fifth track sat empty and the row stopped 242px short of the right
     margin while the section rule above it carried on to the edge.
     auto-fit collapses the unused track, so four steps fill the row and the painter
     pillar's five still fit. 190px keeps five within 1180; below that it steps down
     to the two- and one-column rules in the breakpoints. Nothing in .proc spans the
     full row, which is what stopped auto-fit collapsing in Reviews. */
  .proc { list-style: none; margin: 0; padding: 0;
    display: grid; gap: var(--gap-m);
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); }
  .proc__step { position: relative; padding-top: var(--gap-s); border-top: 2px solid var(--border); }
  .proc__step:first-child { border-top-color: var(--bronze); }
  .proc__day { font-family: var(--font-ui); font-size: var(--step--1); font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--bronze-ink); }
  .proc__title { margin-top: 0.4rem; font-size: var(--step-0); }
  .proc__body { margin-top: 0.45rem; font-size: var(--step--1); color: var(--muted); }
  @media (max-width: 900px) {
    .proc { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .proc { grid-template-columns: 1fr; gap: var(--gap-s); }
    .proc__step { padding-top: 0.7rem; }
  }
</style>
