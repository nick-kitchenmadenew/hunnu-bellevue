---
// Review count is deliberately absent: competitors sit at 55–138 and the
// comparison is one this business loses. The rating is excellent; the count is
// a click away on the profile.
const { rating, since, area } = Astro.props;
const years = new Date().getFullYear() - since;
---
<aside class="proof">
  <p class="proof__item"><strong>{rating.toFixed(1)}</strong> rating on Google</p>
  <p class="proof__item"><strong>{years} years</strong> working in {area}</p>
  <p class="proof__item"><strong>Every quote in writing</strong> before any deposit</p>
</aside>
<style>
  .proof { display: flex; flex-wrap: wrap; gap: var(--gap-s) var(--gap-l);
    padding-top: var(--gap-m); border-top: 1px solid currentColor;
    border-color: color-mix(in srgb, currentColor 22%, transparent); }
  .proof__item { font-size: var(--step--1);
    color: var(--muted-on-dark); }
  .proof__item strong { color: currentColor; font-family: var(--font-ui);
    font-size: var(--step-0); font-weight: 600; }
</style>
