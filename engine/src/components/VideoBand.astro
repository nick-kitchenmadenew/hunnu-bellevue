---
import Rich from './Rich.astro';
import { Image } from 'astro:assets';
/**
 * A walkthrough of a finished kitchen, behind its own poster frame.
 *
 * Nothing but the poster image loads until somebody presses play. That is the
 * same bargain as ChatWidget and LeadForm: this site's PageSpeed rests on having
 * no third-party scripts and nothing heavy on first paint, and a 6 MB video in
 * the markup would spend all of it on something most visitors scroll past.
 *
 * Self-hosted rather than embedded. A YouTube iframe would bring third-party
 * JavaScript back to a page that has none, and VideoObject schema earns the same
 * search treatment either way — Google indexes a self-hosted file with a
 * thumbnail and a description perfectly well.
 *
 * The video is portrait, because it was shot on a phone walking through a
 * kitchen, and that is how these are always shot. So the layout puts it in a
 * narrow column with the copy beside it rather than stretching it across a band
 * built for landscape.
 */
const { src, poster, alt, caption, body } = Astro.props;
// Derived from the filename rather than randomised, so a rebuild with no content
// change produces byte-identical HTML.
const uid = 'vb-' + src.replace(/^.*\//, '').replace(/\.[^.]+$/, '');
---
<div class="vb" id={uid}>
  <figure class="vb__fig">
    <button type="button" class="vb__play" aria-label="Play the walkthrough">
      <Image src={poster} alt={alt} widths={[380, 560, 760]}
             sizes="(max-width: 820px) 95vw, 380px" loading="lazy" decoding="async" />
      <span class="vb__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="30" height="30"><path fill="currentColor" d="M8 5.5v13a1 1 0 0 0 1.5.9l11-6.5a1 1 0 0 0 0-1.7l-11-6.5A1 1 0 0 0 8 5.5Z"/></svg>
      </span>
    </button>
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
  {body?.length > 0 && (
    <div class="vb__body">{body.map((p) => <p><Rich text={p} /></p>)}</div>
  )}
</div>

<script is:inline define:vars={{ src, uid }}>
  (function () {
    var root = document.getElementById(uid);
    var btn = root && root.querySelector('.vb__play');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var v = document.createElement('video');
      v.src = src;
      v.controls = true;
      v.autoplay = true;
      v.playsInline = true;      /* iOS opens fullscreen without this */
      v.preload = 'auto';
      v.className = 'vb__video';
      btn.replaceWith(v);
      v.focus();
    }, { once: true });
  })();
</script>

<style>
  /* Video left, copy right — the same shape as the rest of the page rather than a
     portrait frame stranded in the middle of a 1180px band. */
  .vb { display: grid; grid-template-columns: minmax(0, 380px) minmax(0, var(--measure));
    gap: var(--gap-l); align-items: start; }
  .vb__fig { margin: 0; }
  .vb__play { display: block; width: 100%; padding: 0; border: none; cursor: pointer;
    position: relative; background: none; border-radius: var(--radius); overflow: hidden; }
  .vb__play :global(img) { width: 100%; aspect-ratio: 9 / 16; object-fit: cover;
    display: block; }
  /* Scrim behind the icon so it reads on a bright kitchen as well as a dark one. */
  .vb__icon { position: absolute; inset: 0; margin: auto;
    width: 4.25rem; height: 4.25rem; border-radius: 50%;
    display: grid; place-items: center;
    background: color-mix(in srgb, var(--ink) 78%, transparent); color: var(--bg);
    transition: transform 0.15s ease, background 0.15s ease; }
  .vb__play:hover .vb__icon { background: var(--ink); transform: scale(1.06); }
  .vb__play:focus-visible { outline: 2px solid var(--bronze); outline-offset: 3px; }
  /* :global because this element is created in JS, so it never gets Astro's
     scoping attribute — a plain `.vb__video` rule compiles to
     `.vb__video[data-astro-cid-…]` and silently matches nothing. The video then
     lays out at its intrinsic 720px and breaks the column. Kept inside `.vb`,
     which is scoped, so the global part cannot leak past this component. */
  .vb :global(.vb__video) { width: 100%; aspect-ratio: 9 / 16;
    border-radius: var(--radius); display: block; background: var(--ink); }
  .vb figcaption { margin-top: 0.6rem; font-size: var(--step--1); color: var(--muted); }
  .vb__body { font-size: var(--step-0); }
  .vb__body p { margin: 0 0 var(--gap-s, 0.9rem); }
  .vb__body p:last-child { margin-bottom: 0; }
  /* Single column on phones, and the figure fills it. A vertical video capped
     short of the gutter leaves a ragged right edge that reads as a mistake —
     full-bleed-to-the-column is how phone-shot video is meant to be watched, and
     it earns its height as a break in a page Nick already found too wordy here. */
  @media (max-width: 820px) {
    .vb { grid-template-columns: 1fr; gap: var(--gap-m); }
  }
  @media (prefers-reduced-motion: reduce) { .vb__icon { transition: none; } }
</style>
