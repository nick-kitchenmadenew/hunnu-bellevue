---
/** A warranty stated on its own is a promise. Put it beside a customer describing
    it being honoured a year later and it becomes evidence. */
const { claim, proof } = Astro.props;
---
<aside class="wty">
  <div class="wty__claim">
    <p class="eyebrow">After the job</p>
    <p class="wty__headline">{claim}</p>
  </div>
  {proof && (
    <figure class="wty__proof">
      <blockquote>{proof.text}</blockquote>
      <figcaption>{proof.name} · on a job finished a year earlier</figcaption>
    </figure>
  )}
</aside>
<style>
  .wty { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: var(--gap-l); align-items: start;
    padding: var(--gap-m) 0 0; border-top: 2px solid var(--bronze); }
  .wty__headline { margin-top: 0.5rem; font-family: var(--font-display);
    font-size: var(--step-2); line-height: 1.2; text-wrap: balance; }
  .wty__proof { margin: 0; }
  .wty__proof blockquote { margin: 0; color: var(--muted); }
  .wty__proof figcaption { margin-top: 0.7rem; font-family: var(--font-ui);
    font-size: var(--step--1); letter-spacing: 0.04em; color: var(--muted); }
  @media (max-width: 820px) { .wty { grid-template-columns: 1fr; gap: var(--gap-m); } }
</style>
